/**
 * Table : Invitation
 */
enum InvitationStatus {
  SENT
  EXPIRED
  ACCEPTED
  CANCELED

  @@map("invitation_status")
}

model Invitation {
  id                String           @id @default(cuid())
  inviterUserId     String           @map("inviter_id")
  inviteeUserId     String?          @map("invitee_id")
  inviteeUserEmail  String           @map("invitee_email") @db.VarChar(100)
  status            InvitationStatus @default(SENT)
  invitedAt         DateTime         @default(now()) @map("invited_at")
  acceptedAt        DateTime?        @map("accepted_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt      @map("updated_at")

  inviter        User             @relation("SentInvitations", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee        User?            @relation("ReceivedInvitations", fields: [inviteeUserId], references: [id], onDelete: SetNull)

  accountsLinked InvitationAccountLink[]
  entitiesLinked InvitationEntityLink[]
  rolesLinked    InvitationRoleLink[]

  @@index([inviterUserId])
  @@index([inviteeUserId])
  @@index([status])
  @@index([inviteeUserEmail, status])
  @@map("invitations")
}

/**
 * Table : Relation Invitation - Account
 */
model InvitationAccountLink {
  invitationId String   @map("invitation_id")
  accountId    String   @map("account_id")
  createdAt    DateTime @default(now()) @map("created_at")

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([invitationId, accountId])
  @@index([invitationId])
  @@index([accountId])
  @@map("invitations_accounts_links")
}

/**
 * Table : Relation Invitation - Entity
 */
model InvitationEntityLink {
  invitationId String   @map("invitation_id")
  entityId     String   @map("entity_id")
  createdAt    DateTime @default(now()) @map("created_at")

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  entity       Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([invitationId, entityId])
  @@index([invitationId])
  @@index([entityId])
  @@map("invitations_entities_links")
}

/**
 * Table : Relation Invitation - Role
 */
model InvitationRoleLink {
  invitationId String   @map("invitation_id")
  roleId       Int      @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at")

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([invitationId, roleId])
  @@index([invitationId])
  @@index([roleId])
  @@map("invitations_roles_links")
}

