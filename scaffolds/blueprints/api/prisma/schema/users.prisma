/**
 * Enums
 */
enum Locale {
  EN
  FR

  @@map("locale")
}

enum TokenType {
  ACCOUNT_VALIDATION
  SESSION_REFRESH
  PASSWORD_RESET
  INVITATION

  @@map("token_type")
}

/**
 * Table : People
 */
model People {
  id          String    @id @default(cuid())
  firstname   String?   @db.VarChar(80)
  lastname    String?   @db.VarChar(80)
  email       String?   @db.VarChar(100)
  createdAt   DateTime  @default(now())               @map("created_at")
  updatedAt   DateTime  @updatedAt                    @map("updated_at")

  user        User?     @relation("UserProfile")

  accountsLinked PeopleAccountLink[]
  entitiesLinked PeopleEntityLink[]

  @@map("people")
}

/**
 * Table : User
 */
model User {
  id             String    @id @default(cuid())
  isActive       Boolean   @default(false)               @map("is_active")
  peopleId       String?   @unique                       @map("people_id")
  email          String    @unique @db.VarChar(100)
  password       String    @db.VarChar(255)
  lastLoginAt    DateTime?                               @map("last_login_at")
  createdAt      DateTime  @default(now())               @map("created_at")
  updatedAt      DateTime  @updatedAt                    @map("updated_at")


  preference     UserPreference?   @relation("UserPreference")
  people         People?           @relation("UserProfile", fields: [peopleId], references: [id])

  tokens         UserToken[]       @relation("UserToken")

  rolesLinked    UserRoleLink[]
  accountsLinked UserAccountLink[]
  entitiesLinked UserEntityLink[]

  sentInvitations     Invitation[] @relation("SentInvitations")
  receivedInvitations Invitation[] @relation("ReceivedInvitations")

  @@index([isActive])
  @@map("users")
}

/**
 * Table : User Token
 */
model UserToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  token       String    @db.VarChar(500)
  type        TokenType
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User     @relation("UserToken", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([token])
  @@map("user_tokens")
}

/**
 * Table : Role
 */
model Role {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(30)
  description       String?  @db.VarChar(255)
  isActive          Boolean  @default(false)                  @map("is_active")
  accountId         String?                                   @map("account_id")
  createdAt         DateTime @default(now())                  @map("created_at")
  updatedAt         DateTime @updatedAt                       @map("updated_at")

  account           Account? @relation("RoleAccount", fields: [accountId], references: [id], onDelete: SetNull)

  usersLinked       UserRoleLink[]
  modulesLinked     RoleModuleLink[]
  permissionsLinked RolePermissionLink[]
  entitiesLinked    EntityRoleLink[]
  invitationsLinked InvitationRoleLink[]

  @@unique([name, accountId])
  @@index([isActive])
  @@index([accountId])
  @@map("roles")
}


/**
 * Table : User Preferences
 */
model UserPreference {
  id        Int     @id @default(autoincrement())
  userId    String  @unique                           @map("user_id")
  avatarUrl String? @db.VarChar(255)                  @map("avatar_url")
  updatedAt DateTime @updatedAt                       @map("updated_at")
  locale    Locale  @default(FR)

  user      User    @relation("UserPreference", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/**
 * Table : Relation User - Roles
 */
model UserRoleLink {
  userId    String                                    @map("user_id")
  roleId    Int                                       @map("role_id")
  createdAt DateTime @default(now())                  @map("created_at")
  updatedAt DateTime @updatedAt                       @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("users_roles_links")
}