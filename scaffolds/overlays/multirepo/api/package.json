{
  "name": "saasfoundry-api",
  "version": "0.0.0",
  "description": "Backend API for SaaSFoundry",
  "private": true,
  "prisma": {
    "schema": "prisma/schema"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agachet/saasfoundry/apps/api"
  },
  "homepage": "https://github.com/agachet/saasfoundry/#readme",
  "bugs": {
    "url": "https://github.com/agachet/saasfoundry/issues"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "nest build",
    "build:ci": "HUSKY=0 CI=true nest build",
    "format": "prettier --write .",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/main",
    "lint": "eslint --config eslint.config.mjs .",
    "lint:fix": "eslint --config eslint.config.mjs . --fix",
    "type-check": "tsc -b",
    "test:unit": "NODE_NO_WARNINGS=1 jest --config jest.config.js --silent",
    "test:unit:verbose": "NODE_NO_WARNINGS=1 jest --config jest.config.js --verbose --detectOpenHandles --forceExit --logHeapUsage",
    "test:unit:watch": "NODE_NO_WARNINGS=1 jest --config jest.config.js --watch",
    "test:unit:coverage": "NODE_NO_WARNINGS=1 jest --config jest.config.js --coverage",
    "test:unit:debug": "NODE_NO_WARNINGS=1 node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config jest.config.js --runInBand",
    "test:e2e": "NODE_NO_WARNINGS=1 jest --config jest-e2e.config.js --runInBand --silent",
    "test:e2e:verbose": "NODE_NO_WARNINGS=1 E2E_VERBOSE=true jest --config jest-e2e.config.js --runInBand --verbose --detectOpenHandles --forceExit --logHeapUsage",
    "test:e2e:coverage": "NODE_NO_WARNINGS=1 jest --config jest-e2e.config.js --runInBand --coverage --coverageDirectory=coverage-e2e",
    "test:full": "npm run format && npm run lint && npm run type-check && npm run test:unit && npm run test:e2e",
    "test:full:verbose": "npm run format && npm run lint && npm run type-check && npm run test:unit:verbose && npm run test:e2e:verbose",
    "db:update:dev": "./scripts/update-db-dev.sh",
    "db:update:prod": "./scripts/update-db-prod.sh",
    "db:init:test": "./scripts/init-test-db.sh",
    "services:up": "docker compose -f docker-compose.dev-services.yml up -d",
    "services:down": "docker compose -f docker-compose.dev-services.yml down",
    "services:reset": "docker compose -f docker-compose.dev-services.yml down -v && docker compose -f docker-compose.dev-services.yml up -d",
    "version:manage": "./scripts/tag-manager.sh \"$(git symbolic-ref --short HEAD)\"",
    "prepare": "if [ \"$HUSKY\" != \"0\" ]; then husky; fi",
    "postinstall": "if [ \"$HUSKY\" != \"0\" ] && [ -d './scripts' ]; then find ./scripts -type f -name '*.sh' -exec chmod +x {} +; fi"
  },
  "keywords": [
    "saasfoundry",
    "open-source",
    "backend",
    "nest",
    "prisma"
  ],
  "dependencies": {
    "@nestjs/common": "11.1.13",
    "@nestjs/core": "11.1.13",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.13",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/serve-static": "5.0.4",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/terminus": "11.0.0",
    "@prisma/adapter-pg": "7.4.0",
    "@prisma/client": "7.4.0",
    "@types/cookie-parser": "1.4.10",
    "bcrypt": "6.0.0",
    "chalk": "5.6.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.3.1",
    "mailersend": "2.6.0",
    "ms": "2.1.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "punycode": "2.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.13",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.11",
    "@types/bcrypt": "6.0.0",
    "@types/chalk": "2.2.4",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/ms": "2.1.0",
    "@types/node": "25.2.3",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsonc": "2.21.1",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.3.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "prettier": "3.8.1",
    "prisma": "7.4.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0"
  }
}
